# IDLE ORBIT build-time configuration.
# Copy to .env.prod (git-ignored) and build with:
#   flutter build appbundle --dart-define-from-file=.env.prod -P ADMOB_APP_ID=ca-app-pub-xxx~yyy
#
# Without any defines the app runs in "dev": Google's public TEST ad units,
# store sandbox purchases. Never put real IDs in this example file.

APP_ENV=dev

# Feature switches (true/false)
ADS_ENABLED=true
IAP_ENABLED=true
ANALYTICS_ENABLED=false

# Production AdMob ad unit IDs (only read when APP_ENV=prod).
# If any is empty in prod, that ad type is disabled (no fallback to test ads).
ADMOB_REWARDED_ANDROID=
ADMOB_REWARDED_IOS=
ADMOB_INTERSTITIAL_ANDROID=
ADMOB_INTERSTITIAL_IOS=

# AdMob APP IDs are NOT dart-defines; they are native settings:
#   Android: gradle property  -P ADMOB_APP_ID=ca-app-pub-xxx~yyy
#   iOS:     ios/Flutter/Secrets.xcconfig  ->  ADMOB_APP_ID=ca-app-pub-xxx~yyy
